# Optional: the server runs without a .env file. Copy this to server/.env only to change
# a default. Never commit server/.env.

# Port the API listens on. Render sets this for you in production.
PORT=4000

# Where the React app runs. Only these origins may call the API (CORS). Separate several
# with commas, e.g. your Vercel site and its preview URL.
CLIENT_ORIGIN=http://localhost:5173

# Where the SQLite database file and uploaded files are kept.
# Defaults: server/data/studyapp.db and server/data/uploads
DATABASE_PATH=
UPLOADS_PATH=

# AI provider for study notes, quizzes and topics: mock, gemini, anthropic or openai.
# "mock" needs no API key: it builds notes and quizzes straight from your resources.
# The assistant lets students pick an AI from every provider below that has a
# key, plus practice mode; its default is this provider.
AI_PROVIDER=mock

# Speech-to-text for audio and video uploads: mock, gemini or openai (Whisper).
# "mock" saves a placeholder transcript so uploads still work without a key.
TRANSCRIPTION_PROVIDER=mock

# Used when either provider above is gemini. Get a key at https://aistudio.google.com/apikey
# Models are chosen per task (see DEFAULT_GEMINI_MODELS in config/constants.js); set these
# only to change the first-choice model for a task.
GEMINI_API_KEY=
# Optional: more Gemini keys, comma-separated. Requests take turns between all the keys,
# and one that hits its rate limit hands the request to the next, so the limits are
# reached much less often.
GEMINI_BACKUP_API_KEYS=
GEMINI_LIGHT_MODEL=
GEMINI_STANDARD_MODEL=
GEMINI_TRANSCRIPTION_MODEL=

# Used when AI_PROVIDER=anthropic, and offered in the assistant when set. The model
# defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Used when either provider above is openai, and offered in the assistant when set. The
# model defaults to gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=
